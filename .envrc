# direnv: project-local env shim.
# pulpline uses PyPI directly. The user's global UV_INDEX points at pyx.dev,
# which we unset here so `uv sync`, `uv run`, etc. resolve against PyPI.
# To activate: `direnv allow` (one-time, requires direnv installed).
# Without direnv this file is a no-op.

unset UV_INDEX
unset PYX_API_KEY

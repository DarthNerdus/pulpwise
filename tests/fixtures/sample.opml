<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Sample Subscriptions</title>
  </head>
  <body>
    <outline text="Tech">
      <outline text="Stratechery"
               type="rss"
               xmlUrl="https://stratechery.com/feed"
               htmlUrl="https://stratechery.com"/>
      <outline text="Sam Kriss"
               type="rss"
               xmlUrl="https://samkriss.substack.com/feed"
               htmlUrl="https://samkriss.substack.com"/>
    </outline>
    <outline text="ML">
      <outline text="HuggingFace Blog"
               type="rss"
               xmlUrl="https://huggingface.co/blog/feed.xml"/>
    </outline>
    <outline text="Loose feed (no folder)"
             type="rss"
             xmlUrl="https://example.com/feed.xml"/>
  </body>
</opml>
